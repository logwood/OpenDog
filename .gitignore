# Workspace layout: source is tracked; local inputs, runtime outputs, recovery
# material and binary model payloads are not.
/data/
/artifacts/
/archive/
/models/pretrained/

# Selected-model metadata and the registry are source-controlled. Binary
# payloads below them remain excluded by the global model/media patterns.

# Guard against accidentally recreating generated directories inside source.
/src/Pet-ReID-IMAG/data/
/src/Pet-ReID-IMAG/datasets/
/src/Pet-ReID-IMAG/pretrain/
/src/Pet-ReID-IMAG/logs/

# Legacy locations stay guarded until and after their contents are migrated.
/logs/
/results/
/upstream/Pet-ReID-IMAG/data/
/upstream/Pet-ReID-IMAG/datasets/
/upstream/Pet-ReID-IMAG/pretrain/
/upstream/Pet-ReID-IMAG/logs/

# Vendor training annotations are local data, not application source.
/upstream/Pet-ReID-IMAG/third_party/AnyFace/yolov5-face/widerface/
/src/Pet-ReID-IMAG/third_party/AnyFace/yolov5-face/widerface/

# Generated outputs.
**/outputs/
**/checkpoints/
**/weights/

# Dataset/media/archive/model formats. Keep these ignored globally so newly
# downloaded assets cannot be committed accidentally from another directory.
*.csv
*.tsv
*.parquet
*.arrow
*.feather
*.npy
*.npz
*.mat
*.h5
*.hdf5
*.lmdb
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.webp
*.tif
*.tiff
*.mp4
*.avi
*.mov
*.mkv
*.wav
*.mp3
*.pth
*.pt
*.ckpt
*.onnx
*.safetensors
*.pkl
*.pickle
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
*.zip
*.7z
*.rar
*.tar
*.tgz
*.tar.gz

# Python/build/editor caches.
__pycache__/
*.py[cod]
*.so
*.dll
*.o
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/
node_modules/
.next/
target/
dist/
build/
.idea/
.vscode/

# Local credentials and machine-specific environment files.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
credentials*
secrets*
