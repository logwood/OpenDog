{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true, "jsx": "preserve", "skipLibCheck": true, "isolatedModules": true, "noUnusedLocals": true,
    "types": ["vite/client"], "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "../sdk/src/**/*.ts"]
}
