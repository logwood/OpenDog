{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler", "lib": ["ES2022", "DOM", "WebWorker"],
    "strict": true, "noImplicitOverride": true, "noUnusedLocals": true, "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true, "types": ["node"], "isolatedModules": true, "verbatimModuleSyntax": true
  },
  "include": ["src", "test"]
}
