<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/status_page"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/page_padding">

        <TextView
            style="@style/Pawprint.Heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_page_title" />

        <TextView
            style="@style/Pawprint.Body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/status_page_intro" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/card_background"
            android:elevation="2dp"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Pawprint.SectionHeading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_card_title" />

                    <TextView
                        android:id="@+id/status_checked_at"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="@string/status_waiting"
                        android:textColor="@color/pawprint_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:background="@drawable/soft_card_background"
                    android:gravity="center"
                    android:minWidth="76dp"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:text="@string/status_not_configured"
                    android:textColor="@color/pawprint_green"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/status_detail"
                style="@style/Pawprint.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/connection_help" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:text="@string/status_server_label"
                android:textColor="@color/pawprint_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/status_server_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="middle"
                android:maxLines="1"
                android:text="@string/status_not_configured"
                android:textColor="@color/pawprint_text"
                android:textIsSelectable="true"
                android:textSize="14sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/retry_connection_button"
                style="@style/Pawprint.Button.Secondary"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="18dp"
                android:text="@string/action_retry" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginEnd="7dp"
                android:layout_weight="1"
                android:background="@drawable/soft_card_background"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/status_pet_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/number_zero"
                    android:textColor="@color/pawprint_ink"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/metric_pets"
                    android:textColor="@color/pawprint_muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="112dp"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:background="@drawable/soft_card_background"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/status_image_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/number_zero"
                    android:textColor="@color/pawprint_ink"
                    android:textSize="30sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/metric_images"
                    android:textColor="@color/pawprint_muted"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/card_background"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                style="@style/Pawprint.SectionHeading"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_model_title" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/status_model_provider"
                android:textColor="@color/pawprint_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/status_model_provider_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/status_unknown"
                android:textColor="@color/pawprint_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/status_model_architecture"
                android:textColor="@color/pawprint_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/status_model_architecture_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/status_unknown"
                android:textColor="@color/pawprint_text"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/status_model_fingerprint"
                android:textColor="@color/pawprint_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/status_model_fingerprint_value"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="middle"
                android:maxLines="1"
                android:text="@string/status_unknown"
                android:textColor="@color/pawprint_text"
                android:textIsSelectable="true"
                android:textSize="13sp"
                android:typeface="monospace" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/soft_card_background"
            android:orientation="vertical"
            android:padding="@dimen/card_padding">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/status_privacy_title"
                android:textColor="@color/pawprint_green_dark"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                style="@style/Pawprint.Body"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="@string/status_privacy_body" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
